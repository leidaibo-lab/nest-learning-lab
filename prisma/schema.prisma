generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique @db.VarChar(254)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  notifications  Notification[]

  @@map("users")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(120)
  ownerId     String          @map("owner_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  tasks       Task[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id        String      @id @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  title     String      @db.VarChar(120)
  status    String      @default("todo") @db.VarChar(20)
  version   Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events    TaskEvent[]

  @@index([projectId, createdAt])
  @@map("tasks")
}

model TaskEvent {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @db.Uuid
  fromStatus String   @map("from_status") @db.VarChar(20)
  toStatus   String   @map("to_status") @db.VarChar(20)
  version    Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  notificationJob NotificationJob?
  notifications Notification[]

  @@unique([taskId, version])
  @@index([taskId, createdAt])
  @@map("task_events")
}

model NotificationJob {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id") @db.Uuid
  status      String   @default("pending") @db.VarChar(20)
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError   String?  @map("last_error") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  event       TaskEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("notification_jobs")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  taskEventId String   @map("task_event_id") @db.Uuid
  kind        String   @db.VarChar(50)
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskEvent   TaskEvent @relation(fields: [taskEventId], references: [id], onDelete: Cascade)

  @@unique([userId, taskEventId])
  @@index([userId, createdAt])
  @@map("notifications")
}
